{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["../vendor/frontend/web/src/lib/*"],
      "three": ["./types/three.d.ts"]
    }
  },
  "include": ["src", "test", "types", "build.mjs"]
}
