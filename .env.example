# Copy to .env (never commit .env):  cp .env.example .env
# docker compose reads .env for ${VAR} substitution AND passes it to every service via env_file.
# Variables of docs/ARCHITECTURE.md are listed first; compose-only knobs follow.

# ---- application (docs/ARCHITECTURE.md "Env vars") --------------------------------------------------------------
# dev | prod. APP_ENV=prod forces DEV_AUTH off and requires BOT_TOKEN.
APP_ENV=dev
# 1 = accept "Authorization: dev <tg_id>[:<name>]" and the web client's "X-Dev-User: <tg_id>". Never enable in prod.
DEV_AUTH=1
# Host-style URLs, used when you run api/pytest/alembic from your machine against the compose db/redis.
# Inside compose these are overridden with db:5432 / redis:6379 / sim:8080 (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://mosprom:mosprom@127.0.0.1:55432/mosprom
REDIS_URL=redis://127.0.0.1:56379/0
SIM_URL=http://127.0.0.1:58080
SIM_TIMEOUT_S=3
# Telegram bot token from @BotFather. Empty: the bot process idles (compose stays green) and
# initData validation cannot work (use DEV_AUTH=1).
BOT_TOKEN=
# Username of the bot WITHOUT "@" (S14, web login through the bot): the api builds the deep link https://t.me/<BOT_USERNAME>?start=weblogin_<nonce>
# for POST /api/auth/web/start. Empty: that endpoint answers 503 config_error (the 6-digit code login still works).
BOT_USERNAME=
# initData older than this (seconds) -> 401 auth_expired
INIT_DATA_MAX_AGE_S=86400
# 1 only together with the pgbouncer profile (disables asyncpg prepared statement caches)
PGBOUNCER=0
# Public domain served by caddy. localhost = local dev with caddy's internal CA; http://localhost = plain HTTP.
DOMAIN=localhost
LOG_LEVEL=INFO

# ---- compose / infra --------------------------------------------------------------------------------------------
# Postgres credentials (db service and the URLs compose builds for api/migrate/bot). Use URL-safe characters.
POSTGRES_USER=mosprom
POSTGRES_PASSWORD=mosprom
POSTGRES_DB=mosprom
# Where api/bot connect to Postgres inside compose. With `--profile pgbouncer`: DB_HOST=pgbouncer DB_PORT=6432 PGBOUNCER=1
DB_HOST=db
DB_PORT=5432

# Host ports of caddy (change if 80/443 are taken, e.g. by IIS/Skype on Windows). With DOMAIN=localhost
# and non-default HTTPS_PORT use https://localhost:<HTTPS_PORT>.
HTTP_PORT=80
HTTPS_PORT=443

# sim: pinned to the vendored frontend commit. Prefer:  SIM_COMMIT=$(scripts/simcommit.sh) docker compose up -d --build
SIM_COMMIT=dev
# Node cluster workers inside the sim container (max 4)
SIM_WORKERS=2

# Public https URL of the Mini App = where caddy serves the web build (web/Dockerfile), https://<DOMAIN>/ . The bot puts it
# in the Play button (Telegram requires https for WebApp buttons); the api derives its prod CORS origin from it. The web
# build and the api share this origin, so the client calls relative /api/* and prod needs no CORS at all.
# Compose expands ${DOMAIN} (defined above). With DOMAIN=http://localhost (plain HTTP) write the URL out: WEBAPP_URL=http://localhost/app
WEBAPP_URL=https://${DOMAIN}/app
# api CORS: comma-separated allowed origins of the web client ("*" = any). Only for a dev server on ANOTHER origin (vite on
# :5173 against this api); the served web build is same-origin and does not use CORS. Empty: APP_ENV=dev -> http://localhost:5173,
# APP_ENV=prod -> the origin of WEBAPP_URL (else https://$DOMAIN). Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# ---- S7: stabilisation ------------------------------------------------------------------------------------------
# Shared secret of the api's /internal/* endpoints (bot -> api background jobs, header X-Internal-Token). Caddy never
# proxies /internal/*. The dev value below works with APP_ENV=dev only: the api REFUSES TO START with APP_ENV=prod
# unless this is a real secret (>= 16 chars). Generate:  openssl rand -hex 24
INTERNAL_TOKEN=dev-internal-token
# uvicorn worker processes of the api (1..4; every worker holds a DB pool of 5 + 5 connections)
API_WORKERS=2
# Timeouts: DB statement 3 s / lock wait 2 s (set on every connection, or client-side with PGBOUNCER=1), sim SIM_TIMEOUT_S (3),
# whole request 5 s (503 `timeout`; /internal/* exempt). Requests slower than SLOW_REQUEST_MS log a WARNING.
DB_STATEMENT_TIMEOUT_MS=3000
DB_LOCK_TIMEOUT_MS=2000
REQUEST_TIMEOUT_S=5
SLOW_REQUEST_MS=1000
# Sim circuit breaker (per api process): N consecutive failures -> fail fast (503 sim_unavailable) for OPEN_S, then one probe.
SIM_BREAKER_THRESHOLD=5
SIM_BREAKER_OPEN_S=10

# Backups (`docker compose --profile backup up -d backup`, or scripts/backup.sh by hand): files land in ./backups
BACKUP_INTERVAL_H=6
BACKUP_KEEP=28

# ---- S6: HR bot -------------------------------------------------------------------------------------------------
# Telegram user ids (comma separated) allowed to use the HR commands (/leads /lead /export /funnel /sources /stats /top)
# and the lead-card status buttons; also the default recipients of lead cards and of the 5xx alert. Ask @userinfobot for an id.
# Empty: nobody can use them and the lead outbox is not consumed (rows wait until this is set).
# C3: bootstrap only. On startup the api inserts every id here as an active `admin` into hr_users when absent; after that the
# table (roles hr|hr_lead|analyst|admin, managed in the CRM: /api/hr/users) is the source of truth. The bot falls back to this
# list only while hr_users is empty or unreachable.
HR_ADMIN_TG_IDS=
# Optional chat / group id (e.g. -1001234567890) that receives lead cards instead of each admin's private chat.
HR_CHAT_ID=
# 1 (default) = demo bots appear in the HR /top (marked 🤖) and in the leaderboard; 0 hides them everywhere. Never in funnel/export/sources.
BOTS_ENABLED=1

# ---- S6: player reminders + 5xx alert (no extra variables; both jobs idle without BOT_TOKEN) -----------------------------
# Order reminders: only players who pressed /start AND tapped "Напоминать о заказах" (or sent /notify; /stop turns them off) get
# one, every 5 min, for accepted/loading orders whose completion is <= 15 min away or whose deadline is <= 60 min away; never
# 23:00-09:00 MSK; each (player, order, kind) once (table reminders_sent). Needs DATABASE_URL (set by compose).
# 5xx alert: the api counts requests / 5xx per minute in Redis (metrics:req:*, metrics:5xx:* - set by compose via REDIS_URL);
# every minute the bot sums the last 10 min and, with >= 20 requests and > 20% 5xx, warns HR_ADMIN_TG_IDS (cooldown 15 min).

# Regional runtime identity and optional Sentinel.
REGION_ID=local
RELEASE_ID=dev
REDIS_SENTINEL_NODES=
REDIS_MASTER_NAME=mosprom
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
REDIS_TLS=0
REDIS_CA_FILE=
# HA bot ownership: HTTPS etcd v3 endpoints and mTLS credentials (mounted files).
ETCD_ENDPOINTS=
ETCD_CA_FILE=
ETCD_CERT_FILE=
ETCD_KEY_FILE=
BOT_LEASE_KEY=/mosprom/dev/bot

# ---- S15: site media in SeaweedFS -------------------------------------------------------------------------------------
# Credentials of the SeaweedFS identity `media-writer` (used by the media-sync one-shot inside the compose network; the public gets
# anonymous read-only access to bucket `media` through caddy). deploy/seaweedfs/s3.json is a template filled from these two values at
# container start. Keys: >= 8 chars of [A-Za-z0-9_-]. The dev defaults are acceptable for a closed network; set real ones for prod:
#   openssl rand -hex 16
MEDIA_S3_ACCESS_KEY=media-writer-dev
MEDIA_S3_SECRET_KEY=media-writer-dev-secret
# 1 (default): media-sync deletes bucket objects that are no longer in vendor/frontend/web/static (renamed / removed media). 0 keeps them.
MEDIA_SYNC_PRUNE=1
