# Copy to .env (never commit .env):  cp .env.example .env
# docker compose reads .env for ${VAR} substitution AND passes it to every service via env_file.
# Variables of docs/ARCHITECTURE.md are listed first; compose-only knobs follow.

# ---- application (docs/ARCHITECTURE.md "Env vars") --------------------------------------------------------------
# dev | prod. APP_ENV=prod forces DEV_AUTH off and requires BOT_TOKEN.
APP_ENV=dev
# 1 = accept "Authorization: dev <tg_id>[:<name>]". Never enable in prod.
DEV_AUTH=1
# Host-style URLs, used when you run api/pytest/alembic from your machine against the compose db/redis.
# Inside compose these are overridden with db:5432 / redis:6379 / sim:8080 (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://mosprom:mosprom@127.0.0.1:55432/mosprom
REDIS_URL=redis://127.0.0.1:56379/0
SIM_URL=http://127.0.0.1:58080
SIM_TIMEOUT_S=3
# Telegram bot token from @BotFather. Empty: the bot process idles (compose stays green) and
# initData validation cannot work (use DEV_AUTH=1).
BOT_TOKEN=
# initData older than this (seconds) -> 401 auth_expired
INIT_DATA_MAX_AGE_S=86400
# 1 only together with the pgbouncer profile (disables asyncpg prepared statement caches)
PGBOUNCER=0
# Public domain served by caddy. localhost = local dev with caddy's internal CA; http://localhost = plain HTTP.
DOMAIN=localhost
LOG_LEVEL=INFO

# ---- compose / infra --------------------------------------------------------------------------------------------
# Postgres credentials (db service and the URLs compose builds for api/migrate/bot). Use URL-safe characters.
POSTGRES_USER=mosprom
POSTGRES_PASSWORD=mosprom
POSTGRES_DB=mosprom
# Where api/bot connect to Postgres inside compose. With `--profile pgbouncer`: DB_HOST=pgbouncer DB_PORT=6432 PGBOUNCER=1
DB_HOST=db
DB_PORT=5432

# Host ports of caddy (change if 80/443 are taken, e.g. by IIS/Skype on Windows). With DOMAIN=localhost
# and non-default HTTPS_PORT use https://localhost:<HTTPS_PORT>.
HTTP_PORT=80
HTTPS_PORT=443

# sim: pinned to the vendored frontend commit. Prefer:  SIM_COMMIT=$(scripts/simcommit.sh) docker compose up -d --build
SIM_COMMIT=dev
# Node cluster workers inside the sim container (max 4)
SIM_WORKERS=2

# bot: public https URL of the Mini App (defaults to https://$DOMAIN). Telegram requires https for WebApp buttons.
WEBAPP_URL=
