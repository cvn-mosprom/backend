{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["../../vendor/frontend/web/src/lib/*"],
      "three": ["./types/three.d.ts"]
    }
  },
  "include": ["*.ts", "types"]
}
