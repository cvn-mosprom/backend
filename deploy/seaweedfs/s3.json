{
  "identities": [
    {
      "name": "media-writer",
      "credentials": [
        {
          "accessKey": "${MEDIA_S3_ACCESS_KEY}",
          "secretKey": "${MEDIA_S3_SECRET_KEY}"
        }
      ],
      "actions": ["Admin:media", "Read:media", "Write:media", "List:media"]
    },
    {
      "name": "anonymous",
      "actions": ["Read:media"]
    }
  ]
}
